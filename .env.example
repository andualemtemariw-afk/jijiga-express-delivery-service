# Firebase Environment Configuration (Overrides firebase-applet-config.json when specified)
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIRESTORE_DATABASE_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Firebase Emulators (Set true for local offline development; uses Auth :9099 and Firestore :8080)
VITE_USE_FIREBASE_EMULATORS="false"
VITE_FIREBASE_AUTH_EMULATOR_HOST="127.0.0.1:9099"
VITE_FIREBASE_FIRESTORE_EMULATOR_HOST="127.0.0.1"
VITE_FIREBASE_FIRESTORE_EMULATOR_PORT="8080"

# Optional AI Studio/runtime values; never commit real secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform Map Preview
# Restrict any Maps key by website origin and enabled API.
VITE_GOOGLE_MAPS_API_KEY=""

# VITE_GOOGLE_MAPS_MAP_ID: Optional custom Google Cloud Map ID for Cloud Styling & Advanced Markers
# Defaults to Google's official sample Map ID (bf51a910020fa25a) if omitted.
VITE_GOOGLE_MAPS_MAP_ID=""

# Explicit demo-only UI/synthetic telemetry gate. Keep false/empty in production.
VITE_ENABLE_DEMO_SANDBOX="false"
