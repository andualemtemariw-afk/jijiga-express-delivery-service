# Set true for local development; the app then uses Auth :9099 and Firestore :8080.
VITE_USE_FIREBASE_EMULATORS="false"

# Optional AI Studio/runtime values; never commit real secrets.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=""

# VITE_GOOGLE_MAPS_API_KEY: Required for Google Maps Platform Map Preview
# Restrict any Maps key by website origin and enabled API.
VITE_GOOGLE_MAPS_API_KEY=""
