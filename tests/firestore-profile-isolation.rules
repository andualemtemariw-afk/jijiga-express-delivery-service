rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'phone', 'city',
          'address', 'plusCode', 'role', 'createdAt'
        ]);

      // Isolated test variant: compare optional values using Map.get defaults.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.get('active', false) == false
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('mamilaId', '') == '';
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
