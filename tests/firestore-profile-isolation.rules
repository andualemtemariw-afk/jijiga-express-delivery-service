rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer'
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'photoURL', 'phone', 'city',
          'address', 'plusCode', 'role', 'createdAt'
        ]);

      // Isolated test variant: deny protected-key additions using only field presence.
      allow update: if request.auth != null
        && request.auth.uid == uid
        && !('active' in request.resource.data)
        && !('isAdmin' in request.resource.data)
        && !('mamilaId' in request.resource.data);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
