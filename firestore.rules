rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? currentUser().data.role
        : 'customer';
    }

    function isAdmin() {
      return signedIn() && getUserRole() == 'admin';
    }

    function isRunner() {
      return signedIn() && getUserRole() == 'runner';
    }

    function isRider() {
      return signedIn() && getUserRole() == 'rider';
    }

    function isMamila() {
      return signedIn() && getUserRole() == 'mamila';
    }

    function orderDoc(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId));
    }

    function isOrderCustomer(orderId) {
      return signedIn() && orderDoc(orderId).data.customerId == request.auth.uid;
    }

    function isOrderRunner(orderId) {
      return signedIn() && orderDoc(orderId).data.runnerId == request.auth.uid;
    }

    function isOrderRider(orderId) {
      return signedIn() && orderDoc(orderId).data.riderId == request.auth.uid;
    }

    function roleMatchesSender() {
      return (getUserRole() == 'customer' && request.resource.data.senderRole == 'CUSTOMER')
        || (getUserRole() == 'runner' && request.resource.data.senderRole == 'RUNNER')
        || (getUserRole() == 'rider' && request.resource.data.senderRole == 'RIDER')
        || (getUserRole() == 'admin' && request.resource.data.senderRole == 'ADMIN');
    }

    function validRunnerTransition() {
      return (
        resource.data.status in ['PENDING', 'TRANSACTION_PENDING'] && request.resource.data.status == 'RUNNER_ASSIGNED'
      ) || (
        resource.data.status == 'RUNNER_ASSIGNED' && request.resource.data.status in ['VERIFIED_READY', 'READY_FOR_RIDER', 'DEFECT_REJECTED']
      ) || (
        resource.data.status == request.resource.data.status
      );
    }

    function validRiderTransition() {
      return (
        resource.data.status in ['READY_FOR_RIDER', 'VERIFIED_READY'] && request.resource.data.status == 'RIDER_ACCEPTED'
      ) || (
        resource.data.status in ['RIDER_ACCEPTED', 'RIDER_DISPATCHED'] && request.resource.data.status in ['RIDER_DISPATCHED', 'IN_TRANSIT', 'PICKED_UP']
      ) || (
        resource.data.status in ['PICKED_UP', 'IN_TRANSIT'] && request.resource.data.status == 'DELIVERED'
      ) || (
        resource.data.status == request.resource.data.status
      );
    }

    // Connection probe only. Do not store sensitive data here.
    match /test/connection {
      allow read: if true;
    }

    // User profiles. Self-registration can ONLY create a customer profile.
    // Staff/admin roles must be provisioned by an existing admin or the explicit bootstrap emails.
    match /users/{uid} {
      allow read: if signedIn() && (
        isAdmin() || request.auth.uid == uid || getUserRole() in ['runner', 'rider']
      );

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.uid == uid
        && request.resource.data.role == 'customer'
        || (
          signedIn()
          && request.auth.uid == uid
          && request.resource.data.uid == uid
          && request.resource.data.role == 'admin'
          && userEmail() in ['andualemawraris4@gmail.com', 'andualemawraris104@gmail.com', 'andualemawraris3@gmail.com']
        );

      allow update: if signedIn() && (
        isAdmin()
        || (
          request.auth.uid == uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'uid', 'createdAt'])
        )
      );

      allow delete: if isAdmin();
    }

    // Public merchant catalog. Administrative writes only until merchant ownership is provisioned.
    match /mamilas/{mamilaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Public inventory catalog. A Mamila may only create/update batches assigned to their own mamilaId.
    match /batches/{batchId} {
      allow read: if true;
      allow create: if isAdmin() || (
        isMamila()
        && request.resource.data.mamilaId == currentUser().data.mamilaId
        && request.resource.data.price is number
        && request.resource.data.available is number
        && request.resource.data.available >= 0
      );
      allow update: if isAdmin() || (
        isMamila()
        && resource.data.mamilaId == currentUser().data.mamilaId
        && request.resource.data.mamilaId == resource.data.mamilaId
        && request.resource.data.price is number
        && request.resource.data.available is number
        && request.resource.data.available >= 0
      ) || (
        signedIn()
        && request.resource.data.mamilaId == resource.data.mamilaId
        && request.resource.data.price == resource.data.price
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['available', 'updatedAt', 'lastReservationId'])
        && request.resource.data.available >= 0
        && request.resource.data.lastReservationId != resource.data.lastReservationId
        && existsAfter(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.lastReservationId))
        && getAfter(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.lastReservationId)).data.customerId == request.auth.uid
        && getAfter(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.lastReservationId)).data.batchId == batchId
        && (
          (
            getAfter(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.lastReservationId)).data.action == 'RESERVE'
            && !exists(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.lastReservationId))
            && request.resource.data.available == resource.data.available - getAfter(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.lastReservationId)).data.quantity
          )
          ||
          (
            getAfter(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.lastReservationId)).data.action == 'RELEASE'
            && request.resource.data.available == resource.data.available + getAfter(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.lastReservationId)).data.quantity
          )
        )
      );
      allow delete: if isAdmin();
    }


    // Inventory reservations are written in the same transaction as the order.
    // The reservation links the customer, order and batch so stock changes cannot
    // be made arbitrarily by a customer.
    match /inventoryReservations/{reservationId} {
      allow read: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0
        && (
          (
            request.resource.data.action == 'RESERVE'
            && request.resource.data.orderId == reservationId
            && getAfter(/databases/$(database)/documents/orders/$(reservationId)).data.customerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/orders/$(reservationId)).data.status == 'PENDING'
          )
          ||
          (
            request.resource.data.action == 'RELEASE'
            && reservationId == request.resource.data.orderId + '-release'
            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.customerId == request.auth.uid
            && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.status == 'CANCELLED'
            && get(/databases/$(database)/documents/inventoryReservations/$(request.resource.data.orderId)).data.action == 'RESERVE'
          )
        );
      allow update, delete: if isAdmin();
    }

    match /orders/{orderId} {
      // Customer sees only own orders; runners/riders see dispatch pools and their assigned work;
      // admins see all orders. No generic "active order" read for arbitrary signed-in users.
      allow read: if signedIn() && (
        isAdmin()
        || resource.data.customerId == request.auth.uid
        || (isRunner() && (resource.data.runnerId == request.auth.uid || resource.data.status in ['PENDING', 'TRANSACTION_PENDING', 'RUNNER_ASSIGNED']))
        || (isRider() && (resource.data.riderId == request.auth.uid || resource.data.status in ['READY_FOR_RIDER', 'VERIFIED_READY', 'RIDER_DISPATCHED', 'RIDER_ACCEPTED', 'IN_TRANSIT', 'PICKED_UP', 'DELIVERED']))
      );

      // Customer-created orders always start in PENDING state and cannot self-assign couriers.
      allow create: if signedIn()
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'PENDING'
        && !('runnerId' in request.resource.data)
        && !('riderId' in request.resource.data)
        && request.resource.data.price is number
        && request.resource.data.totalPrice is number
        && request.resource.data.price >= 0
        && request.resource.data.totalPrice >= 0
        && request.resource.data.quantity is number
        && request.resource.data.quantity > 0;

      allow update: if signedIn() && (
        isAdmin()
        || (
          // Customer may cancel eligible orders, rate delivered orders, and file/update a dispute.
          resource.data.customerId == request.auth.uid
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.price == resource.data.price
          && request.resource.data.totalPrice == resource.data.totalPrice
          && request.resource.data.deliveryFee == resource.data.deliveryFee
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rating', 'reviewComment', 'dispute'])
          && (
            request.resource.data.status == resource.data.status
            || (resource.data.status in ['PENDING', 'TRANSACTION_PENDING', 'RUNNER_ASSIGNED'] && request.resource.data.status == 'CANCELLED')
            || (resource.data.status in ['DELIVERED', 'RATED'] && request.resource.data.status in ['DELIVERED', 'RATED'])
          )
        )
        || (
          isRunner()
          && ((('runnerId' in resource.data) && resource.data.runnerId == request.auth.uid) || (!('runnerId' in resource.data) && request.resource.data.runnerId == request.auth.uid))
          && request.resource.data.runnerName == currentUser().data.displayName
          && request.resource.data.price == resource.data.price
          && request.resource.data.totalPrice == resource.data.totalPrice
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'runnerId', 'runnerName', 'runnerTagId', 'defectReason', 'updatedAt'])
          && validRunnerTransition()
        )
        || (
          isRider()
          && ((('riderId' in resource.data) && resource.data.riderId == request.auth.uid) || (!('riderId' in resource.data) && request.resource.data.riderId == request.auth.uid))
          && request.resource.data.riderName == currentUser().data.displayName
          && request.resource.data.price == resource.data.price
          && request.resource.data.totalPrice == resource.data.totalPrice
          && request.resource.data.customerId == resource.data.customerId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'riderId', 'riderName', 'riderProofUrl', 'riderCoordinates', 'paymentStatus', 'eeuDetails', 'updatedAt'])
          && validRiderTransition()
          && (
            request.resource.data.paymentStatus == resource.data.paymentStatus
            || (
              resource.data.paymentMethod == 'COD'
              && request.resource.data.status == 'DELIVERED'
              && request.resource.data.paymentStatus == 'COLLECTED_BY_RIDER'
            )
          )
        )
      );

      allow delete: if isAdmin();

      // Only participants in the order can see/write its chat.
      match /messages/{messageId} {
        allow read: if isAdmin() || isOrderCustomer(orderId) || isOrderRunner(orderId) || isOrderRider(orderId);
        allow create: if (isAdmin() || isOrderCustomer(orderId) || isOrderRunner(orderId) || isOrderRider(orderId))
          && request.resource.data.orderId == orderId
          && request.resource.data.senderId == request.auth.uid
          && roleMatchesSender()
          && request.resource.data.senderName == currentUser().data.displayName;
        allow update, delete: if isAdmin();
      }
    }

    // Deprecated standalone chat collection is intentionally closed. The application uses order-scoped chats.
    match /orderChats/{chatId} {
      allow read, write: if false;
    }

    // Immutable delivery events: actor identity must match the authenticated account and the order role.
    match /deliveryEvents/{eventId} {
      allow read: if isAdmin()
        || (signedIn() && (
          resource.data.actorId == request.auth.uid
          || (resource.data.orderId is string && isOrderCustomer(resource.data.orderId))
          || (resource.data.orderId is string && isOrderRunner(resource.data.orderId))
          || (resource.data.orderId is string && isOrderRider(resource.data.orderId))
        ));

      allow create: if signedIn()
        && request.resource.data.actorId == request.auth.uid
        && (
          (getUserRole() == 'customer' && request.resource.data.actorRole == 'CUSTOMER' && isOrderCustomer(request.resource.data.orderId))
          || (getUserRole() == 'runner' && request.resource.data.actorRole == 'RUNNER' && isOrderRunner(request.resource.data.orderId))
          || (getUserRole() == 'rider' && request.resource.data.actorRole == 'RIDER' && isOrderRider(request.resource.data.orderId))
          || (getUserRole() == 'admin' && request.resource.data.actorRole == 'ADMIN')
        );

      allow update, delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
