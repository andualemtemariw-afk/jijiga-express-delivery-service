{
  "firestore": [
    {
      "database": "(default)",
      "rules": "firestore.rules"
    },
    {
      "database": "ai-studio-remixjijigaexpre-729909c5-f38a-4c4a-8d31-a10d6eb77286",
      "rules": "firestore.rules"
    }
