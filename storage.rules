rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function userDoc() { return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)); }
    function isActiveAdmin() {
      return signedIn()
        && userDoc().data.role == 'admin'
        && (!('active' in userDoc().data) || userDoc().data.active == true);
    }
    function orderDoc(orderId) { return firestore.get(/databases/(default)/documents/orders/$(orderId)); }

    match /eeuReceipts/{orderId}/{fileName} {
      allow read: if isActiveAdmin()
        || (signedIn() && orderDoc(orderId).data.customerId == request.auth.uid)
        || (signedIn() && orderDoc(orderId).data.riderId == request.auth.uid);
      allow create: if signedIn()
        && orderDoc(orderId).data.riderId == request.auth.uid
        && resource == null
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*')
        && request.resource.metadata.orderId == orderId
        && request.resource.metadata.riderId == request.auth.uid;
      allow update: if false;
      allow delete: if isActiveAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
